node_modules/

# Secrets. The token lives in ~/.agent-dashboard/token and never in the repo.
.env
.env.*
!.env.example

# Runner state. Session ids, terminal buffers and the hire registry are local
# to a machine and some of it echoes repo contents.
.state/
logs/
*.log

# Agent and session state. Written into the working tree by the tools used to
# develop Stafford, not by Stafford. It contains conversation transcripts, so it
# is closer to a private notebook than to build output, and this repository is
# going public.
#
# .gitignore rather than .git/info/exclude, deliberately. See CONVENTIONS.md:
# decision 7's rule is about repositories Stafford manages for someone else, and
# this is Stafford's own. info/exclude would protect this clone and leave the
# work PC and every future clone unprotected.
.letta/

# Local Claude Code config Stafford or a dev may write into this repo. Stafford's
# own hooks live in its managed config dir, not here, but a stale or manual copy of
# these must never be committed to this public repo.
.claude/settings.local.json
.claude/settings.local.json.disabled

# Windows and editor noise
Thumbs.db
desktop.ini
.vscode/
.idea/
# Build output
out/
dist/

# electron-vite writes a temporary resolved config beside the real one during dev.
electron.vite.config.*.timestamp-*.mjs
electron.vite.config.*.mjs
